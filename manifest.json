
{
  "manifest_version": 3,
  "name": "YouTube Sin Cuenta",
  "version": "2.3",
  "description": "Buscador y reproductor de vídeos educativos.",
  "permissions": [],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube-nocookie.com;"
  }
}
